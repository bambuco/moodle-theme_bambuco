{{!
    @template theme_bambuco/courseheader_column

    This template renders the course header in columns.

    Example context (json):
    {
        "hasbanner": true,
        "imageurl": "http://localhost/moodle/pluginfile.php/1/course/overviewfiles/banner.jpg",
        "coursename": "My Course"
    }
}}

{{#hasbanner}}
    <div class="courseheader_column coursebanner">
        <img src="{{{imageurl}}}" class="course-bannerimg" alt="{{{coursename}}}">
    </div>
{{/hasbanner}}