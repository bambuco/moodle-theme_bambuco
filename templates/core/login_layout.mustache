{{!
    @template core/login_layout

    Split-screen layout for login-flow pages (login, MFA, etc.).

    Same structure as Boost, with the site logo above the form. logourl, sitename
    and wwwroot come from the theme_bambuco/login page context.

    Context variables required for this template:
    * output - The core renderer output object (provides main_content).
    * logourl - Logo URL, when a logo is configured.
    * sitename - Site name, used as the logo alt text.
    * wwwroot - Site home URL.

    Example context (json):
    {
        "output": {
            "main_content": "<h1>Login form goes here</h1>"
        },
        "logourl": "https://example.com/logo.png",
        "sitename": "Site name",
        "wwwroot": "https://example.com/"
    }
}}
<div id="page-content" class="min-vh-100 row g-0">
    <aside class="login-layout-left col-lg-6 d-none d-lg-flex">
        {{> core/login_panel }}
    </aside>
    <div id="region-main" class="login-layout-right col-12 col-lg-6">
        <div id="region-main-box" class="login-layout-right-content">
            <div class="login-container">
                {{#logourl}}
                    <div id="loginlogo" class="login-logo">
                        <a href="{{wwwroot}}">
                            <img id="logoimage" src="{{logourl}}" class="img-fluid" alt="{{sitename}}">
                        </a>
                    </div>
                {{/logourl}}
                {{{ output.main_content }}}
            </div>
        </div>
    </div>
</div>
